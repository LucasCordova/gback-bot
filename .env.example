# =============================================================================
# gback-bot — Environment Variables
# Copy to .env for local dev, or set in Railway Variables for deployment.
# =============================================================================

# ---------------------------------------------------------------------------
# Discord (required)
# ---------------------------------------------------------------------------
# Bot token: https://discord.com/developers/applications → Your App → Bot
DISCORD_BOT_TOKEN=your_bot_token_here

# Channel ID for scheduled fact posts (Developer Mode → right-click channel → Copy ID)
CHANNEL_ID=1234567890123456789

# ---------------------------------------------------------------------------
# Postgres (required)
# ---------------------------------------------------------------------------
# Railway provides this automatically when you attach a Postgres plugin.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/gback_bot

# ---------------------------------------------------------------------------
# Chat RAG API (required)
# ---------------------------------------------------------------------------
# Base URL of your FastAPI RAG service (no trailing slash)
CHAT_API_URL=https://your-chat-service.up.railway.app

# Shop identifier and widget token (must match your FastAPI config)
CHAT_API_SHOP=gback
CHAT_WIDGET_TOKEN=your_chat_widget_token_here

# ---------------------------------------------------------------------------
# Fact posting (optional)
# ---------------------------------------------------------------------------
# Minutes between scheduled fact posts (default: 480 = 8 hours)
FACT_INTERVAL_MINUTES=480

# Prompt(s) for fact generation. Can be a plain string or JSON:
#   Plain:  "Give me a random fact about coffee"
#   JSON:   {"prompt": ["fact about X", "fact about Y"]}
#   Array:  ["fact about X", "fact about Y"]
FACT_PROMPT=Give me a random fact

# ---------------------------------------------------------------------------
# Chat history (optional)
# ---------------------------------------------------------------------------
# Number of recent message pairs (user+assistant) to include as context.
# Higher = more context but more tokens. Default: 5
CHAT_HISTORY_LIMIT=5
